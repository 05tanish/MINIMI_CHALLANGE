NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
AUTH_TOKEN=replace-with-a-long-random-secret
VITE_API_TOKEN=replace-with-the-same-long-random-secret
REDIS_REST_URL=
REDIS_REST_TOKEN=
DATABASE_URL=postgresql://user:password@localhost:5432/minimi?schema=public
GEMINI_API_KEY=
# Optional environment-specific forms. The server and Prisma scripts select
# the suffix matching NODE_ENV when the generic variable above is empty.
DATABASE_URL_DEVELOPMENT=
DATABASE_URL_PRODUCTION=
GEMINI_API_KEY_DEVELOPMENT=
GEMINI_API_KEY_PRODUCTION=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.7-flash
GEMINI_THINKING_LEVEL=low
GEMINI_MODEL_TIMEOUT_MS=10000
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
TAVILY_API_KEY=
USER_TIMEZONE=Asia/Kolkata
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
SEARCH_TIMEOUT_MS=12000
LLM_TIMEOUT_MS=30000
RESEARCH_BUDGET_MS=45000
MAX_SEARCH_QUERIES=4
MAX_CONTEXT_CHUNKS=8
MAX_REQUEST_BYTES=64kb
