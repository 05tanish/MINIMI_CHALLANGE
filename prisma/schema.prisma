generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  Message[]
  chunks    MemoryChunk[]
  summary   ConversationSummary?
  sources   ResearchSource[]
  mentions  EntityMention[]
  turns     ChatTurn[]
  claims    ResearchClaim[]
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  createdAt    DateTime @default(now())
  sessions     Session[]
  conversations Conversation[]
  turns        ChatTurn[]
  claims       ResearchClaim[]
}

model Session {
  tokenHash String @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String   @db.Text
  createdAt      DateTime @default(now())
  searchVector   Unsupported("tsvector")?
  conversation  Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  mentions       EntityMention[]
  claims         ResearchClaim[]
  sources        ResearchSource[]
  userTurn       ChatTurn? @relation("TurnUserMessage")
  assistantTurn ChatTurn? @relation("TurnAssistantMessage")

  @@index([conversationId, createdAt])
}

model MemoryChunk {
  id             String   @id @default(cuid())
  conversationId String
  content        String   @db.Text
  topic          String?
  entities       Json     @default("[]")
  metadata       Json     @default("{}")
  startAt        DateTime
  endAt          DateTime
  embedding      Unsupported("vector(768)")?
  searchVector   Unsupported("tsvector")?
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, startAt, endAt])
}

model Entity {
  id             String @id @default(cuid())
  name           String
  normalizedName String @unique
  type           String
  mentions       EntityMention[]
  claims         ResearchClaim[]
}

model EntityMention {
  id             String @id @default(cuid())
  entityId       String
  messageId      String
  conversationId String
  createdAt      DateTime @default(now())
  entity         Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  message        Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([entityId, messageId])
  @@index([conversationId, createdAt])
}

model ConversationSummary {
  id             String @id @default(cuid())
  conversationId String @unique
  summary        String @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  conversation  Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model ChatTurn {
  id                String   @id @default(cuid())
  userId            String
  conversationId    String
  userMessageId     String   @unique
  assistantMessageId String? @unique
  idempotencyKey    String
  status            String   @default("queued")
  errorCode         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userMessage       Message @relation("TurnUserMessage", fields: [userMessageId], references: [id], onDelete: Cascade)
  assistantMessage  Message? @relation("TurnAssistantMessage", fields: [assistantMessageId], references: [id], onDelete: SetNull)
  events            ChatTurnEvent[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

model ChatTurnEvent {
  id        String   @id @default(cuid())
  turnId    String
  sequence  Int
  type      String
  payload   Json
  createdAt DateTime @default(now())
  turn      ChatTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@unique([turnId, sequence])
  @@index([turnId, createdAt])
}

model OutboxEvent {
  id          String   @id @default(cuid())
  type        String
  aggregateId String
  payload     Json
  status      String   @default("pending")
  attempts    Int      @default(0)
  runAt       DateTime @default(now())
  lockedAt    DateTime?
  lastError   String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, runAt, createdAt])
  @@index([aggregateId, status])
}

model ResearchSource {
  id             String @id @default(cuid())
  conversationId String
  messageId      String
  title          String
  url            String
  snippet        String @db.Text
  publishedAt    DateTime?
  retrievedAt    DateTime @default(now())
  sourceType     String @default("web")
  metadata       Json @default("{}")
  conversation  Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  claims         ResearchClaim[]

  @@unique([messageId, url])
  @@index([conversationId, retrievedAt])
}

model ResearchClaim {
  id         String @id @default(cuid())
  userId     String
  conversationId String?
  entityId   String
  attribute  String
  value      String
  validAt    DateTime?
  recordedAt DateTime @default(now())
  sourceId   String?
  messageId  String?
  origin     String @default("memory")
  evidenceKey String @unique
  entity     Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message    Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  source     ResearchSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([entityId, attribute, recordedAt])
  @@index([userId, entityId, attribute, recordedAt])
}
